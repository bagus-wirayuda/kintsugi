# ==============================================================================
# NGINX REVERSE PROXY CONFIGURATION FOR LINY JAYA
# Salin konfigurasi ini ke /etc/nginx/sites-available/linyjaya dan aktifkan ke sites-enabled
# ==============================================================================

server {
    listen 80;
    server_name tokokintsugi.com www.tokokintsugi.com;

    # Batas ukuran payload upload gambar (Express diset 25MB, default Nginx hanya 1MB)
    client_max_body_size 25M;

    # Direktori build frontend (SPA)
    root /var/www/liny-jaya/dist;
    index index.html;

    # Gzip Compression untuk performa optimal
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # 1. Routing API ke Node.js Express Backend
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # 2. Routing file unggahan produk & bukti bayar (/uploads/)
    # Diteruskan ke Node.js Express agar file di public/uploads maupun dist/uploads terlayani dengan CORS & CORP
    location /uploads/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        add_header Access-Control-Allow-Origin *;
        add_header Cross-Origin-Resource-Policy cross-origin;
    }

    # 3. Routing aset gambar statis (/images/ & /brand/)
    location ~* ^/(images|brand)/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        add_header Access-Control-Allow-Origin *;
        add_header Cross-Origin-Resource-Policy cross-origin;
    }

    # 4. Aset bundle JS/CSS Vite (immutable cache)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 5. Routing Frontend Single Page Application (SPA Fallback)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
