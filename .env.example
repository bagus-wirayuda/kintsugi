# ==============================================================================
# KINTSUGI STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env pada server VPS (atau mesin lokal) dan sesuaikan nilainya.
# ==============================================================================

# --- Lingkungan & Server ---
# Gunakan 'production' untuk VPS, 'development' untuk lokal
NODE_ENV=production

# Alamat host binding (Gunakan 127.0.0.1 jika menggunakan reverse proxy Nginx di VPS yang sama, atau 0.0.0.0 jika di dalam kontainer Docker)
HOST=127.0.0.1

# Port internal aplikasi Node.js
PORT=3001

# URL publik website utama (wajib menggunakan https:// di VPS, tanpa trailing slash)
# Digunakan untuk callback Xendit, validasi origin CORS/CSRF, dan tautan notifikasi
APP_URL=https://tokokintsugi.com

# Domain tambahan yang diizinkan mengakses API (dipisahkan koma, opsional)
ALLOWED_ORIGINS=https://tokokintsugi.com,https://www.tokokintsugi.com

# Reverse Proxy (Nginx / Caddy / Cloudflare): Set 1 agar IP pelanggan dan protokol HTTPS dikenali dengan benar
TRUST_PROXY=1

# Keamanan Cookie Session: Set true untuk HTTPS production (false jika pengujian HTTP lokal)
COOKIE_SECURE=true

# Batas Rate Limiting API per menit per IP
API_RATE_LIMIT=600

# --- Konfigurasi Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=liny_jaya
DB_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT=10000

# --- Akun Default Administrator (Inisialisasi Pertama) ---
ADMIN_EMAIL=admin@linyjaya.test
ADMIN_PHONE=6281111111111
ADMIN_PASSWORD=AdminLinyJaya2026!

# --- Integrasi Pembayaran (Xendit) ---
# Kunci rahasia API Xendit (xnd_development_... atau xnd_production_...)
XENDIT_SECRET_KEY=
# Token verifikasi webhook Xendit untuk memvalidasi pembayaran otomatis
XENDIT_WEBHOOK_TOKEN=
# Masa berlaku invoice pembayaran dalam detik (default 3600 = 1 jam)
INVOICE_DURATION=3600

# --- Integrasi WhatsApp Gateway (Wablas) ---
# Endpoint API server Wablas
WABLAS_API_HOST=https://texas.wablas.com
# Token perangkat WhatsApp Wablas
WABLAS_TOKEN=
# Secret key Wablas (opsional)
WABLAS_SECRET_KEY=

# --- Integrasi Ekspedisi (RajaOngkir - Opsional) ---
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_ID=

# --- Informasi Kontak Toko ---
STORE_CONTACT_EMAIL=kintsugi@gmail.com
STORE_CONTACT_PHONE=6281111111111
